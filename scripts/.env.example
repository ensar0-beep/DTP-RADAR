# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir. .env asla git'e girmez (.gitignore'da).

# Google Cloud Console → APIs & Services → Credentials → "Geocoding API" için oluşturduğun anahtar.
# Bu script sunucu/yerel makineden çalıştığı için anahtarı IP kısıtlamasıyla (kendi IP'n) sınırlamak iyi olur.
GOOGLE_MAPS_API_KEY=

# Firebase Console → Project Settings → Service Accounts → Generate new private key
# İndirdiğin JSON dosyasının bu klasöre göre yolu (örn. ./serviceAccountKey.json). Bu dosya da git'e girmez.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# index_39.html içindeki firebaseConfig.databaseURL ile aynı olmalı.
FIREBASE_DATABASE_URL=https://diib-d006d-default-rtdb.firebaseio.com
